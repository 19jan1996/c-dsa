#include <iostream>
#include <queue>
using namespace std;

struct Node{
    int val;
    Node *left;
    Node *right;

    Node(int data)
    {
        val = data;
        left =right= nullptr;
    }
};

void levelorder(Node *root)
{
    
   if(root == nullptr)
   return; 
  queue<Node*>q;
  q.push(root);
  while(!q.empty())
  {
      Node* curr = q.front();
          q.pop();
          cout << curr->val <<" ";
          if(curr->left) q.push(curr->left);
          if(curr->right) q.push(curr->right);
  }

}

void inorder(Node* root)
{
if(root == nullptr)
   return; 
   inorder(root->left);
   cout << root->val <<  " ";
   inorder(root->right);
   
}

void preoredr(Node* root)
{
   if(root == nullptr)
   return;   
    cout << root->val << " ";
    preoredr(root->left);
    preoredr(root->right);

}

void postorder(Node* root)
{
    if(root == nullptr)
    return;
    postorder(root->left);
    postorder(root->right);
    cout << root->val << " ";
}
int main() {
    Node* root = new Node(1);
    root->left = new Node(12);
    root->right = new Node(9);
    root->left->left = new Node(5);
    root->left->right = new Node(6);
    


    cout <<"level travsel" <<" ";
    levelorder(root);
    cout <<endl;

    cout <<"inoder travsel" <<" ";
    inorder(root);
    cout <<endl;

    cout <<"preoredr travsel" <<" ";
    preoredr(root);
    cout <<endl;


    cout <<"postorder travsel" <<" ";
    postorder(root);
    cout <<endl;
    return 0;
}
