#include<stdio.h>
#include <stdlib.h> 
int min(int a, int b)
{
return (a<b)?a:b;
}
int max(int a, int b)
{
return (a>b)?a:b;
}

int trapwater(int arr[],int size)
{
int *L = (int*)malloc(size*sizeof(int));
int *R = (int*)malloc(size*sizeof(int));
int left_max =arr[0] , right_max = arr[size-1];
int i;
L[0]= left_max; 
for(i = 1; i<size; i++)
{
L[i] = max(L[i-1],arr[i]);
}
R[size-1]= right_max; 
for(i = size-2; i>=0; i--)
{
R[i] = max(R[i+1],arr[i]);
}
int trap_water = 0;
for(i = 0; i<size; i++)
{
trap_water += min(L[i],R[i]) - arr[i];
}
    free(L);
    free(R);
return trap_water;
}

int main()
{
int arr[7]= {3,5,2,6,0,7,2};
int size = sizeof(arr)/ sizeof(arr[0]);
int ans = trapwater(arr,size);
printf("%d",ans);
return 0;
}
